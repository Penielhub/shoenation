DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/shoenation

# signs the JWTs. generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# first admin account, created by:  python -m app.seed
ADMIN_EMAIL=admin@shoenation.com
ADMIN_PASSWORD=CHANGE_ME
